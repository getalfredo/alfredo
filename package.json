{
  "name": "alfredo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.tsx serve",
    "start": "NODE_ENV=production bun src/index.tsx serve",
    "build": "bun run bin/build.ts",
    "compile": "bun run bin/compile.ts",
    "compile:linux": "bun run bin/compile.ts --target=linux-x64",
    "compile:linux-arm64": "bun run bin/compile.ts --target=linux-arm64",
    "deploy": "bash bin/deploy.sh",
    "vps:compile": "bun run bin/compile.ts --target=linux-$(uname -m | sed -e 's/x86_64/x64/' -e 's/aarch64/arm64/')",
    "vps:up": "bun run vps:compile && docker compose -f dev/vps/compose.yaml up -d --build",
    "vps:down": "docker compose -f dev/vps/compose.yaml down",
    "vps:restart": "bun run vps:compile && docker compose -f dev/vps/compose.yaml restart gotham wayne",
    "vps:logs": "docker compose -f dev/vps/compose.yaml logs -f gotham wayne",
    "vps:default-users": "sh dev/vps/default-users.sh",
    "vps:reset": "docker compose -f dev/vps/compose.yaml down -v"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "better-auth": "^1.5.4",
    "bun-plugin-tailwind": "^0.1.2",
    "bunqueue": "^2.6.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "qrcode.react": "^4.2.0",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/bun": "latest",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.4.0"
  }
}
